@model ITSoftware.Models.ViewModels.BookmarkIndexViewModel
@{
    ViewData["Title"] = "Unified Bookmarks Hub";
    ViewData["Subtitle"] = "আপনার সমস্ত সংরক্ষিত প্রশ্ন ও MCQ এক জায়গায়";
}

<!-- Top Action Header -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1">
            <i class="bi bi-star-fill text-warning me-1"></i> বুকমার্কস সেন্টার (Bookmarks Hub)
        </h5>
        <small class="text-muted">আপনার স্টার চিহ্নিত গুরুত্বপূর্ণ প্রশ্ন ও MCQ গুলো এখানে সংরক্ষিত আছে</small>
    </div>

    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()" style="border-radius:8px;">
            <i class="bi bi-printer me-1"></i>বুকমার্ক প্রিন্ট / PDF
        </button>
    </div>
</div>

<!-- Tabs & Filters -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-body p-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <!-- Tabs -->
            <ul class="nav nav-pills gap-2" id="bookmarkTab" role="tablist">
                <li class="nav-item">
                    <button class="nav-link @(Model.ActiveTab == "questions" ? "active" : "")" id="questions-tab" data-bs-toggle="pill" data-bs-target="#questions-panel" type="button" style="border-radius:20px;font-size:13px;font-weight:600;">
                        <i class="bi bi-patch-question me-1"></i>বিগত সালের প্রশ্ন (@Model.BookmarkedQuestions.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(Model.ActiveTab == "mcqs" ? "active" : "")" id="mcqs-tab" data-bs-toggle="pill" data-bs-target="#mcqs-panel" type="button" style="border-radius:20px;font-size:13px;font-weight:600;">
                        <i class="bi bi-check-circle me-1"></i>টেকনিক্যাল MCQ (@Model.BookmarkedMcqs.Count)
                    </button>
                </li>
            </ul>

            <!-- Search Form -->
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="hidden" name="tab" id="activeTabInput" value="@Model.ActiveTab" />
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchQuery" class="form-control border-start-0" placeholder="বুকমার্ক সার্চ..." style="max-width:200px;" />
                </div>
                <button type="submit" class="btn btn-sm btn-primary" style="border-radius:6px;">সার্চ</button>
            </form>
        </div>
    </div>
</div>

<!-- Tab Contents -->
<div class="tab-content" id="bookmarkTabContent">
    <!-- ══ Tab 1: Bookmarked Questions ══ -->
    <div class="tab-pane fade @(Model.ActiveTab == "questions" ? "show active" : "")" id="questions-panel" role="tabpanel">
        @if (Model.BookmarkedQuestions.Count == 0)
        {
            <div class="text-center py-5 text-muted card border-0 shadow-sm" style="border-radius:14px;">
                <i class="bi bi-star" style="font-size:42px;opacity:0.4;"></i>
                <h6 class="mt-2 mb-1 fw-bold">কোনো বিগত সালের প্রশ্ন বুকমার্ক করা নেই</h6>
                <small>Previous Year Questions সেকশনে গিয়ে স্টার বাটনে ক্লিক করে বুকমার্ক করুন।</small>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var q in Model.BookmarkedQuestions)
                {
                    <div class="col-12" id="bm-qcard-@q.Id">
                        <div class="card border-0 shadow-sm" style="border-radius:14px;border-left:4px solid var(--amber) !important;">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-secondary-subtle text-muted" style="font-size:11px;border-radius:6px;">
                                            #@(q.QuestionNo > 0 ? q.QuestionNo : q.Id)
                                        </span>
                                        <span class="badge bg-primary-subtle text-primary" style="font-size:11px;border-radius:6px;">
                                            @q.Category
                                        </span>
                                        <span class="badge bg-warning-subtle text-warning-emphasis" style="font-size:11px;border-radius:6px;">
                                            @q.Year • @q.ExamOrg • @q.Post
                                        </span>
                                    </div>

                                    <button type="button" class="btn btn-sm btn-link text-warning p-0 text-decoration-none" onclick="removePyqBookmark(@q.Id)" title="বুকমার্ক মুছুন">
                                        <i class="bi bi-star-fill"></i> বুকমার্কড
                                    </button>
                                </div>

                                <div class="q-text mb-3" style="font-size:14.5px;color:var(--text-main);white-space:pre-wrap;">
                                    @q.QuestionText
                                </div>

                                @if (!string.IsNullOrEmpty(q.UserNotes))
                                {
                                    <div class="p-3 mb-0" style="background:var(--bg-notes);border:1px dashed var(--border-notes);border-radius:10px;font-size:12.5px;color:var(--text-notes-content);">
                                        <strong class="d-block mb-1 text-uppercase" style="font-size:11px;letter-spacing:0.04em;color:var(--text-notes-title);">
                                            <i class="bi bi-journal-check me-1"></i>আপনার নোট:
                                        </strong>
                                        <div style="white-space:pre-wrap;">@q.UserNotes</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ══ Tab 2: Bookmarked Technical MCQs ══ -->
    <div class="tab-pane fade @(Model.ActiveTab == "mcqs" ? "show active" : "")" id="mcqs-panel" role="tabpanel">
        @if (Model.BookmarkedMcqs.Count == 0)
        {
            <div class="text-center py-5 text-muted card border-0 shadow-sm" style="border-radius:14px;">
                <i class="bi bi-bookmark-star" style="font-size:42px;opacity:0.4;"></i>
                <h6 class="mt-2 mb-1 fw-bold">কোনো টেকনিক্যাল MCQ বুকমার্ক করা নেই</h6>
                <small>MCQ ব্যাংক সেকশন থেকে যেকোনো প্রশ্নের বুকমার্ক বাটনে ক্লিক করুন।</small>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var m in Model.BookmarkedMcqs)
                {
                    <div class="col-12" id="bm-mcqcard-@m.Id">
                        <div class="card border-0 shadow-sm" style="border-radius:14px;border-left:4px solid var(--primary) !important;">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-subtle text-primary" style="font-size:11px;border-radius:6px;">
                                            @m.Category
                                        </span>
                                        @if (!string.IsNullOrEmpty(m.SubCategory))
                                        {
                                            <span class="badge bg-secondary-subtle text-muted" style="font-size:11px;border-radius:6px;">
                                                @m.SubCategory
                                            </span>
                                        }
                                    </div>

                                    <button type="button" class="btn btn-sm btn-link text-warning p-0 text-decoration-none" onclick="removeMcqBookmark(@m.Id)" title="বুকমার্ক মুছুন">
                                        <i class="bi bi-star-fill"></i> বুকমার্কড
                                    </button>
                                </div>

                                <h6 class="fw-semibold mb-3 lh-base" style="font-size:14.5px;color:var(--text-main);">
                                    @m.QuestionText
                                </h6>

                                <!-- Options Grid -->
                                <div class="row g-2 mb-3" style="font-size:13px;">
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 border rounded-3 @(m.CorrectAnswer == "A" ? "border-success bg-success-subtle fw-semibold" : "")">
                                            <strong>A.</strong> @m.OptionA
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 border rounded-3 @(m.CorrectAnswer == "B" ? "border-success bg-success-subtle fw-semibold" : "")">
                                            <strong>B.</strong> @m.OptionB
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 border rounded-3 @(m.CorrectAnswer == "C" ? "border-success bg-success-subtle fw-semibold" : "")">
                                            <strong>C.</strong> @m.OptionC
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 border rounded-3 @(m.CorrectAnswer == "D" ? "border-success bg-success-subtle fw-semibold" : "")">
                                            <strong>D.</strong> @m.OptionD
                                        </div>
                                    </div>
                                </div>

                                <!-- Explanation -->
                                <div class="p-3" style="background:var(--bg-subtle);border-radius:10px;font-size:12.5px;">
                                    <strong class="text-success d-block mb-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>সঠিক উত্তর: @m.CorrectAnswer (@m.CorrectOptionText)
                                    </strong>
                                    @if (!string.IsNullOrEmpty(m.Explanation))
                                    {
                                        <div class="text-muted mt-1">
                                            <strong>ব্যাখ্যা:</strong> @m.Explanation
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Tab switch tracker
        document.getElementById('questions-tab')?.addEventListener('shown.bs.tab', () => {
            document.getElementById('activeTabInput').value = 'questions';
        });
        document.getElementById('mcqs-tab')?.addEventListener('shown.bs.tab', () => {
            document.getElementById('activeTabInput').value = 'mcqs';
        });

        async function removePyqBookmark(id) {
            try {
                const res = await fetch(`/PreviousYearQuestion/ToggleBookmark?id=${id}`, { method: 'POST' });
                const data = await res.json();
                if (data.success && !data.isBookmarked) {
                    const card = document.getElementById(`bm-qcard-${id}`);
                    if (card) {
                        card.style.transition = 'all 0.3s ease';
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.95)';
                        setTimeout(() => card.remove(), 300);
                    }
                }
            } catch (err) {
                console.error('Error removing bookmark', err);
            }
        }

        async function removeMcqBookmark(id) {
            try {
                const res = await fetch(`/Bookmark/ToggleMcqBookmark?id=${id}`, { method: 'POST' });
                const data = await res.json();
                if (data.success && !data.isBookmarked) {
                    const card = document.getElementById(`bm-mcqcard-${id}`);
                    if (card) {
                        card.style.transition = 'all 0.3s ease';
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.95)';
                        setTimeout(() => card.remove(), 300);
                    }
                }
            } catch (err) {
                console.error('Error removing MCQ bookmark', err);
            }
        }
    </script>
}
