                            <input type="text" name="Category" id="editQCat" required class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">ক্যাটাগরি ক্রম (Order)</label>
                            <input type="number" name="CategoryOrder" id="editQCatOrder" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">প্রশ্ন নম্বর</label>
                            <input type="number" name="QuestionNo" id="editQNo" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">সাল (Year) *</label>
                            <input type="number" name="Year" id="editQYear" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">পরীক্ষা / সংস্থা *</label>
                            <input type="text" name="ExamOrg" id="editQExamOrg" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">পদবী / Post *</label>
                            <input type="text" name="Post" id="editQPost" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">প্রশ্ন (Question Text) *</label>
                            <textarea name="QuestionText" id="editQText" class="form-control" rows="4" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">বাতিল</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4">আপডেট করুন</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Toggle Solved AJAX ──
        async function toggleSolved(id) {
            try {
                const res = await fetch(`/PreviousYearQuestion/ToggleSolved?id=${id}`, {
                    method: 'POST'
                });
                const data = await res.json();
                if (data.success) {
                    const card = document.getElementById(`qcard-${id}`);
                    const btn = document.getElementById(`btn-solved-${id}`);
                    const txt = document.getElementById(`txt-solved-${id}`);
                    const icon = btn.querySelector('i');

                    if (data.isSolved) {
                        card.classList.add('solved-card');
                        btn.classList.add('btn-solved-active');
                        txt.innerText = 'সমাধান হয়েছে';
                        icon.className = 'bi bi-check-circle-fill text-success';
                    } else {
                        card.classList.remove('solved-card');
                        btn.classList.remove('btn-solved-active');
                        txt.innerText = 'বাকি আছে';
                        icon.className = 'bi bi-circle';
                    }

                    // Update top stats count
                    if (data.totalSolved !== undefined) {
                        document.getElementById('top-solved-count').innerText = data.totalSolved;
                    }
                }
            } catch (err) {
                console.error('Error toggling solved state', err);
            }
        }

        // ── Toggle Bookmark AJAX ──
        async function toggleBookmark(id) {
            try {
                const res = await fetch(`/PreviousYearQuestion/ToggleBookmark?id=${id}`, {
                    method: 'POST'
                });
                const data = await res.json();
                if (data.success) {
                    const card = document.getElementById(`qcard-${id}`);
                    const btn = document.getElementById(`btn-bookmark-${id}`);
                    const icon = btn.querySelector('i');

                    if (data.isBookmarked) {
                        card.classList.add('bookmarked-card');
                        btn.classList.add('btn-bookmark-active');
                        icon.className = 'bi bi-star-fill text-warning';
                    } else {
                        card.classList.remove('bookmarked-card');
                        btn.classList.remove('btn-bookmark-active');
                        icon.className = 'bi bi-star';
                    }

                    // Update top stats count
                    if (data.totalBookmarked !== undefined) {
                        document.getElementById('top-bookmarked-count').innerText = data.totalBookmarked;
                    }
                }
            } catch (err) {
                console.error('Error toggling bookmark', err);
            }
        }

        // ── Note Expand / Collapse ──
        function toggleNoteExpand(id, event) {
            if (event) event.stopPropagation();
            const content = document.getElementById(`qnotes-content-${id}`);
            const txt = document.getElementById(`qnotes-toggle-txt-${id}`);
            const chevron = document.getElementById(`qnotes-chevron-${id}`);
            if (!content) return;

            const isCollapsed = content.classList.contains('is-collapsed');
            if (isCollapsed) {
                content.classList.remove('is-collapsed');
                if (txt) txt.innerText = 'সংক্ষেপ';
                if (chevron) chevron.className = 'bi bi-chevron-up';
                content.title = 'ক্লিক করে নোট ছোট করুন';
            } else {
                content.classList.add('is-collapsed');
                if (txt) txt.innerText = 'বিস্তারিত';
                if (chevron) chevron.className = 'bi bi-chevron-down';
                content.title = 'ক্লিক করে সম্পূর্ণ নোট দেখুন';
            }
        }

        // ── Note Modal & Save ──
        let noteModalObj = null;
        function openNoteModal(id, noteText) {
            document.getElementById('modalNoteQuestionId').value = id;
            document.getElementById('modalNoteText').value = noteText || '';
            if (!noteModalObj) {
                noteModalObj = new bootstrap.Modal(document.getElementById('noteModal'));
            }
            noteModalObj.show();
        }

        async function saveNoteAjax() {
            const id = document.getElementById('modalNoteQuestionId').value;
            const note = document.getElementById('modalNoteText').value;

            try {
                const formData = new FormData();
                formData.append('id', id);
                formData.append('note', note);

                const res = await fetch(`/PreviousYearQuestion/SaveNote`, {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    const box = document.getElementById(`qnotes-${id}`);
                    const content = document.getElementById(`qnotes-content-${id}`);
                    const txt = document.getElementById(`qnotes-toggle-txt-${id}`);
                    const chevron = document.getElementById(`qnotes-chevron-${id}`);

                    if (note && note.trim().length > 0) {
                        content.innerText = note;
                        box.style.display = 'block';
                        // Expand the note after saving
                        content.classList.remove('is-collapsed');
                        if (txt) txt.innerText = 'সংক্ষেপ';
                        if (chevron) chevron.className = 'bi bi-chevron-up';
                        content.title = 'ক্লিক করে নোট ছোট করুন';
                    } else {
                        content.innerText = '';
                        box.style.display = 'none';
                    }

                    if (noteModalObj) noteModalObj.hide();
                }
            } catch (err) {
                console.error('Error saving note', err);
            }
        }

        // ── Copy Question ──
        function copyQuestion(id) {
            const text = document.getElementById(`qtext-${id}`).innerText;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById(`copy-btn-${id}`);
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check2 text-success"></i> <span class="text-success">কপি হয়েছে!</span>';
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                }, 2000);
            });
        }

        // ── Edit Modal Fill ──
        let editModalObj = null;
        function openEditModal(id, cat, order, qno, year, exam, post, text) {
            document.getElementById('editQId').value = id;
            document.getElementById('editQCat').value = cat;
            document.getElementById('editQCatOrder').value = order;
            document.getElementById('editQNo').value = qno;
            document.getElementById('editQYear').value = year;
            document.getElementById('editQExamOrg').value = exam;
            document.getElementById('editQPost').value = post;
            document.getElementById('editQText').value = text;

            if (!editModalObj) {
                editModalObj = new bootstrap.Modal(document.getElementById('editQuestionModal'));
            }
            editModalObj.show();
        }
    </script>
}
