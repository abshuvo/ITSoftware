<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Exam Prep Portal</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary:    #534AB7;
            --primary-lt: #EEEDFE;
            --primary-md: #AFA9EC;
            --teal:       #1D9E75;
            --teal-lt:    #E1F5EE;
            --amber:      #BA7517;
            --amber-lt:   #FAEEDA;
            --coral:      #993C1D;
            --coral-lt:   #FAECE7;
            --sidebar-w:  240px;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: #f5f5f3;
            color: #1a1a1a;
        }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed;
            top: 0; left: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: #fff;
            border-right: 1px solid #e8e7e2;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 20px 20px 16px;
            border-bottom: 1px solid #e8e7e2;
        }

        .brand-icon {
            width: 36px; height: 36px;
            background: var(--primary);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: 18px;
            flex-shrink: 0;
        }

        .brand-name   { font-weight: 600; font-size: 15px; color: #1a1a1a; }
        .brand-sub    { font-size: 11px; color: #888; margin-top: 1px; }

        .sidebar-nav  { padding: 12px 0; flex: 1; overflow-y: auto; }

        .nav-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #aaa;
            padding: 10px 20px 4px;
        }

        .nav-item a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px;
            font-size: 13.5px;
            color: #555;
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: all .15s;
        }

        .nav-item a:hover {
            background: #f5f5f3;
            color: #1a1a1a;
        }

        .nav-item a.active {
            background: var(--primary-lt);
            color: var(--primary);
            border-left-color: var(--primary);
            font-weight: 600;
        }

        .nav-item a .nav-icon { font-size: 16px; width: 20px; text-align: center; }

        .nav-badge {
            margin-left: auto;
            font-size: 11px;
            background: #f0f0ee;
            color: #888;
            padding: 2px 7px;
            border-radius: 10px;
        }

        .nav-item a.active .nav-badge {
            background: var(--primary-md);
            color: var(--primary);
        }

        /* ── Progress bar in sidebar ── */
        .sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid #e8e7e2;
        }

        .sidebar-progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #888;
            margin-bottom: 6px;
        }

        .sidebar-progress-label span:last-child {
            color: var(--primary);
            font-weight: 600;
        }

        .progress-thin {
            height: 5px;
            border-radius: 3px;
            background: #ebebeb;
        }

        .progress-thin .progress-bar { border-radius: 3px; }

        /* ── Main content ── */
        .main-content {
            margin-left: var(--sidebar-w);
            min-height: 100vh;
        }

        .topbar {
            position: sticky;
            top: 0;
            background: rgba(245,245,243,.92);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid #e8e7e2;
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 50;
        }

        .topbar-title { font-size: 16px; font-weight: 600; color: #1a1a1a; }
        .topbar-sub   { font-size: 12px; color: #888; margin-top: 1px; }

        .page-body { padding: 28px; }

        /* ── Utility ── */
        .section-badge {
            display: inline-block;
            font-size: 11px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 20px;
        }

        /* ════════════════════════
           MOBILE RESPONSIVE
           ════════════════════════ */

        /* Mobile hamburger button */
        .hamburger {
            display: none;
            background: none;
            border: 1px solid #e8e7e2;
            border-radius: 8px;
            padding: 6px 10px;
            cursor: pointer;
            font-size: 18px;
            color: #555;
            align-items: center;
            justify-content: center;
        }

        /* Overlay যখন sidebar open থাকবে */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.4);
            z-index: 99;
        }

            .sidebar-overlay.show {
                display: block;
            }

        media (max-width: 768px) {
            /* Sidebar default এ hidden */
            .sidebar

        {
            transform: translateX(-100%);
            transition: transform .25s ease;
            z-index: 200;
        }

        /* Sidebar open হলে */
        .sidebar.mobile-open {
            transform: translateX(0);
        }

        /* Main content full width নেবে */
        .main-content {
            margin-left: 0 !important;
        }

        /* Hamburger দেখাবে */
        .hamburger {
            display: flex;
        }

        /* Topbar adjust */
        .topbar {
            padding: 10px 16px;
            gap: 10px;
        }

        .topbar-title {
            font-size: 14px;
        }

        .topbar-sub {
            font-size: 11px;
        }

        /* Page body padding কমাও */
        .page-body {
            padding: 16px;
        }

        /* Date hide করো mobile এ */
        .topbar-date {
            display: none;
        }

        }

        /* ── Desktop Sidebar Collapse ── */
        body.sidebar-collapsed {
            --sidebar-w: 80px; /* Collapse হলে সাইডবারের সাইজ */
        }

            /* Collapse অবস্থায় টেক্সট এবং ব্যাজ হাইড করার জন্য */
            body.sidebar-collapsed .brand-text,
            body.sidebar-collapsed .nav-label,
            body.sidebar-collapsed .nav-badge,
            body.sidebar-collapsed .sidebar-progress-label,
            body.sidebar-collapsed .progress-thin,
            body.sidebar-collapsed .nav-text {
                display: none !important;
            }

            /* Collapse অবস্থায় আইকনগুলো মাঝখানে আনার জন্য */
            body.sidebar-collapsed .sidebar-brand {
                justify-content: center !important;
                padding: 20px 10px 16px;
            }

                body.sidebar-collapsed .sidebar-brand .toggle-btn {
                    display: none; /* Collapse অবস্থায় ৩ ডট হাইড করতে চাইলে */
                }

            body.sidebar-collapsed .nav-item a {
                justify-content: center;
                padding: 12px;
            }

                body.sidebar-collapsed .nav-item a .nav-icon {
                    font-size: 20px;
                }

        /* ৩ ডট বাটনের ডিজাইন */
        .toggle-btn {
            background: none;
            border: none;
            color: #888;
            font-size: 20px;
            cursor: pointer;
            margin-left: auto;
        }

        /* Smooth transition এর জন্য */
        .sidebar, .main-content {
            transition: width 0.3s ease, margin-left 0.3s ease, transform 0.25s ease;
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ══ Sidebar ══ -->
    <aside class="sidebar">
        <div class="sidebar-brand d-flex align-items-center gap-2">
            <div class="brand-icon" onclick="toggleDesktopSidebar()" style="cursor:pointer;"><i class="bi bi-mortarboard-fill"></i></div>
            <div class="brand-text">
                <div class="brand-name">Exam Prep</div>
                <div class="brand-sub">আমার প্রস্তুতি</div>
            </div>
            <!-- 3 Dot Button -->
            <button class="toggle-btn" onclick="handleThreeDotClick()">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-label">Main</div>
            <div class="nav-item">
                <a asp-controller="Home" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="bi bi-grid-1x2 nav-icon"></i> 
                    <span class="nav-text">Dashboard</span>
                </a>
            </div>

            <div class="nav-label" style="margin-top:8px;">Sections</div>
            <div class="nav-item">
                <a asp-controller="Syllabus" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Syllabus" ? "active" : "")">
                    <i class="bi bi-file-earmark-text nav-icon"></i>
                    <span class="nav-text">Syllabus &amp; Guidelines</span>
                    <span class="nav-badge">1</span>
                </a>
            </div>
            <div class="nav-item">
                <a asp-controller="Topic" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Topic" ? "active" : "")">
                    <i class="bi bi-star nav-icon"></i>
                    Important Topics
                    <span class="nav-badge">2</span>
                </a>
            </div>
            <div class="nav-item">
                <a asp-controller="Mcq" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Mcq" ? "active" : "")">
                    <i class="bi bi-check-circle nav-icon"></i>
                    Technical MCQ
                    <span class="nav-badge">3</span>
                </a>
            </div>
            <div class="nav-item">
                <a asp-controller="Note" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Note" ? "active" : "")">
                    <i class="bi bi-journal-text nav-icon"></i>
                    Written Notes
                    <span class="nav-badge">4</span>
                </a>
            </div>
            <div class="nav-item">
                <a asp-controller="NonTech" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "NonTech" ? "active" : "")">
                    <i class="bi bi-people nav-icon"></i>
                    Non-Technical Prep
                    <span class="nav-badge">5</span>
                </a>
            </div>
            <div class="nav-item">
                <a asp-controller="StudyPlan" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "StudyPlan" ? "active" : "")">
                    <i class="bi bi-people nav-icon"></i>
                    Study Plan
                    <span class="nav-badge">5</span>
                </a>
            </div>
        </nav>
        <!-- Daily Goal Quick Widget -->
        <div style="padding:12px 16px;border-top:1px solid #e8e7e2;">
            <a asp-controller="StudyGoal" asp-action="Index"
               style="display:flex;align-items:center;gap:8px;
              text-decoration:none;color:inherit;margin-bottom:8px;">
                <i class="bi bi-bullseye"
                   style="color:var(--primary);font-size:14px;"></i>
                <span style="font-size:12px;font-weight:600;color:#555;">
                    আজকের Goal
                </span>
                <span style="margin-left:auto;font-size:11px;
                     color:var(--primary);font-weight:700;"
                      id="layout-goal-pct">—</span>
            </a>
            <div style="height:4px;background:#f0f0ee;border-radius:2px;overflow:hidden;">
                <div id="layout-goal-bar"
                     style="height:100%;background:var(--primary);
                    border-radius:2px;width:0%;
                    transition:width .6s ease;">
                </div>
            </div>
        </div>

        <div class="sidebar-footer">
            <div class="sidebar-progress-label">
                <span>সামগ্রিক অগ্রগতি</span>
                <span id="sidebar-progress-pct">0%</span>
            </div>
            <div class="progress progress-thin">
                <div class="progress-bar bg-primary" id="sidebar-progress-bar"
                     style="width: 0%"></div>
            </div>
        </div>
        <!-- Sidebar close button — mobile only -->
        <div style="padding:10px 16px;display:flex;justify-content:flex-end;">
            <button onclick="toggleSidebar()"
                    style="display:none;background:none;border:none;
                   font-size:20px;color:#888;cursor:pointer;"
                    id="sidebar-close-btn">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </aside>

    <!-- ══ Main ══ -->
    <div class="main-content">
        <div class="topbar">
            <button class="hamburger" onclick="toggleSidebar()">
                <i class="bi bi-list"></i>
            </button>
            <div>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-sub">@ViewData["Subtitle"]</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted" style="font-size:12px;">
                    <i class="bi bi-calendar3"></i>
                    @DateTime.Now.ToString("dd MMM yyyy")
                </span>
            </div>
        </div>

        <div class="page-body">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Sidebar progress — global progress value set by each page
        function setSidebarProgress(pct) {
            document.getElementById('sidebar-progress-bar').style.width = pct + '%';
            document.getElementById('sidebar-progress-pct').textContent  = pct + '%';
        }
    </script>

    <!-- Mobile overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <script>
        // Desktop Sidebar Toggle
        function toggleDesktopSidebar() {
            if (window.innerWidth > 768) {
                document.body.classList.toggle('sidebar-collapsed');
            }
        }

        // 3 Dot Click Handler (Mobile & Desktop)
        function handleThreeDotClick() {
            if (window.innerWidth > 768) {
                // ডেস্কটপে সাইডবার ছোট/বড় করবে
                toggleDesktopSidebar();
            } else {
                // মোবাইলে ৩ ডটে ক্লিক করলে সাইডবার ফোর্স ক্লোজ করবে
                const sidebar = document.querySelector('.sidebar');
                const overlay = document.getElementById('sidebarOverlay');
                const closeBtn = document.getElementById('sidebar-close-btn');

                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('show');
                if (closeBtn) closeBtn.style.display = 'none';
            }
        }

        // Main Sidebar Toggle (Hamburger Menu & Overlay)
        function toggleSidebar() {
            const sidebar  = document.querySelector('.sidebar');
            const overlay  = document.getElementById('sidebarOverlay');
            const closeBtn = document.getElementById('sidebar-close-btn');
            const isOpen   = sidebar.classList.contains('mobile-open');

            if (isOpen) {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('show');
                if (closeBtn) closeBtn.style.display = 'none';
            } else {
                sidebar.classList.add('mobile-open');
                overlay.classList.add('show');
                if (closeBtn) closeBtn.style.display = 'block';
            }
        }

        // Window resize হলে sidebar reset করো
        window.addEventListener('resize', () => {
            if (window.innerWidth > 768) {
                document.querySelector('.sidebar').classList.remove('mobile-open');
                document.getElementById('sidebarOverlay').classList.remove('show');
            }
        });
    </script>
</body>
</html>