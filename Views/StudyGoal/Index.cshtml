@model ITSoftware.Models.ViewModels.StudyGoalViewModel
@{
    ViewData["Title"] = "Daily Study Goal";
    ViewData["Subtitle"] = "আজকের পড়াশোনার লক্ষ্য";
}

@section Styles {
    <style>
        /* ── Goal ring cards ── */
        .goal-card {
            background: #fff;
            border: 1px solid #e8e7e2;
            border-radius: 14px;
            padding: 22px;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: box-shadow .2s;
        }

            .goal-card:hover {
                box-shadow: 0 4px 16px rgba(0,0,0,.07);
            }

            .goal-card.done {
                border-color: #5DCAA5;
            }

        .done-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: var(--teal-lt);
            color: #085041;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 20px;
            display: none;
        }

        .goal-card.done .done-badge {
            display: block;
        }

        .ring-container {
            position: relative;
            width: 110px;
            height: 110px;
            margin: 0 auto 14px;
        }

        .ring-svg {
            transform: rotate(-90deg);
        }

        .ring-bg {
            fill: none;
            stroke: #f0f0ee;
            stroke-width: 9;
        }

        .ring-fill {
            fill: none;
            stroke-width: 9;
            stroke-linecap: round;
            transition: stroke-dashoffset 1s ease;
        }

        .ring-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }

        .ring-pct {
            font-size: 22px;
            font-weight: 800;
            line-height: 1;
        }

        .ring-sub {
            font-size: 11px;
            color: #888;
        }

        .goal-label {
            font-size: 13px;
            font-weight: 600;
            color: #1a1a1a;
        }

        .goal-count {
            font-size: 12px;
            color: #888;
            margin-top: 3px;
        }

        /* Quick log buttons */
        .quick-btns {
            display: flex;
            gap: 5px;
            justify-content: center;
            margin-top: 12px;
        }

        .qbtn {
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 6px;
            border: 1px solid #e8e7e2;
            background: #f5f5f3;
            color: #555;
            cursor: pointer;
            transition: all .15s;
        }

            .qbtn:hover {
                background: var(--primary-lt);
                color: var(--primary);
                border-color: var(--primary-md);
            }

        /* ── Overall card ── */
        .overall-card {
            background: var(--primary);
            border-radius: 14px;
            padding: 24px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .overall-ring-wrap {
            position: relative;
            width: 90px;
            height: 90px;
            flex-shrink: 0;
        }

        .overall-ring-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }

        .overall-pct {
            font-size: 22px;
            font-weight: 800;
            line-height: 1;
        }

        .overall-lbl {
            font-size: 10px;
            opacity: .75;
        }

        .overall-info h4 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .overall-info p {
            font-size: 13px;
            opacity: .85;
            margin: 0;
        }

        .streak-badge {
            margin-left: auto;
            text-align: center;
            flex-shrink: 0;
        }

        .streak-num {
            font-size: 32px;
            font-weight: 800;
            line-height: 1;
        }

        .streak-lbl {
            font-size: 11px;
            opacity: .75;
        }

        /* ── Week history ── */
        .week-row {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
        }

        .day-cell {
            text-align: center;
            padding: 10px 4px;
            border-radius: 8px;
            border: 1px solid #f0f0ee;
            background: #fafaf8;
        }

            .day-cell.today {
                border-color: var(--primary-md);
                background: var(--primary-lt);
            }

            .day-cell.goal-met {
                border-color: #5DCAA5;
                background: var(--teal-lt);
            }

        .day-name {
            font-size: 10px;
            color: #aaa;
            margin-bottom: 5px;
        }

        .day-date {
            font-size: 13px;
            font-weight: 600;
            color: #1a1a1a;
        }

        .day-cell.today .day-name,
        .day-cell.today .day-date {
            color: var(--primary);
        }

        .day-cell.goal-met .day-name,
        .day-cell.goal-met .day-date {
            color: #085041;
        }

        .day-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #e8e7e2;
            margin: 5px auto 0;
        }

        .day-cell.goal-met .day-dot {
            background: var(--teal);
        }

        .day-cell.today .day-dot {
            background: var(--primary);
        }

        /* ── Panels ── */
        .panel {
            background: #fff;
            border: 1px solid #e8e7e2;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .panel-header {
            padding: 13px 18px;
            border-bottom: 1px solid #f0f0ee;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-body {
            padding: 16px 18px;
        }

        /* ── Log list ── */
        .log-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 0;
            border-bottom: 1px solid #f5f5f3;
            font-size: 13px;
        }

            .log-item:last-child {
                border-bottom: none;
            }

        .log-type-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        .log-desc {
            flex: 1;
            color: #555;
        }

        .log-count {
            font-size: 12px;
            font-weight: 700;
        }

        .log-time {
            font-size: 11px;
            color: #aaa;
        }

        /* ── Goal settings form ── */
        .settings-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .setting-item label {
            font-size: 12px;
            font-weight: 600;
            color: #555;
            margin-bottom: 4px;
            display: block;
        }

        .setting-item .hint {
            font-size: 11px;
            color: #aaa;
            margin-top: 3px;
        }

        /* ── Manual log form ── */
        .manual-form {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: flex-end;
        }

            .manual-form select,
            .manual-form input {
                border-radius: 8px;
                border: 1px solid #e8e7e2;
                padding: 8px 10px;
                font-size: 13px;
                outline: none;
            }

                .manual-form select:focus,
                .manual-form input:focus {
                    border-color: var(--primary);
                }

            .manual-form button {
                padding: 8px 16px;
                border-radius: 8px;
                background: var(--primary);
                color: #fff;
                border: none;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
            }

        /* Confetti overlay when all done */
        .all-done-banner {
            background: linear-gradient(135deg, #1D9E75, #0F6E56);
            border-radius: 12px;
            padding: 18px 22px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
            animation: pop .4s ease;
        }

        @@keyframes pop {
            0% {
                transform: scale(.95);
                opacity: 0;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .all-done-icon {
            font-size: 36px;
        }

        .all-done-text h4 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 3px;
        }

        .all-done-text p {
            font-size: 13px;
            opacity: .85;
            margin: 0;
        }
    </style>
}

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert mb-3"
         style="background:#E1F5EE;border:1px solid #5DCAA5;
                border-radius:10px;color:#085041;font-size:13px;">
        <i class="bi bi-check-circle-fill me-1"></i>@TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert mb-3"
         style="background:#FAECE7;border:1px solid #F0997B;
                border-radius:10px;color:#712B13;font-size:13px;">
        <i class="bi bi-exclamation-circle-fill me-1"></i>@TempData["Error"]
    </div>
}

<!-- All done banner -->
@if (Model.IsAllDone)
{
    <div class="all-done-banner">
        <div class="all-done-icon">🎉</div>
        <div class="all-done-text">
            <h4>আজকের সব goal সম্পন্ন! অসাধারণ!</h4>
            <p>তুমি আজকের MCQ, Topic আর Notes — সব শেষ করেছো। কাল আবার নতুন লক্ষ্য নিয়ে শুরু করো।</p>
        </div>
    </div>
}

<!-- ══ Overall progress card ══ -->
<div class="overall-card mb-4">
    <div class="overall-ring-wrap">
        <svg width="90" height="90" viewBox="0 0 90 90">
            <circle cx="45" cy="45" r="36"
                    class="ring-bg"
                    style="stroke:rgba(255,255,255,.2);" />
            <circle cx="45" cy="45" r="36"
                    class="ring-fill"
                    stroke="#fff"
                    stroke-dasharray="226.2"
                    stroke-dashoffset="@(226.2 - 226.2 * Model.OverallTodayPercent / 100)"
                    transform="rotate(-90 45 45)"
                    id="overall-ring" />
        </svg>
        <div class="overall-ring-center">
            <div class="overall-pct">@Model.OverallTodayPercent%</div>
            <div class="overall-lbl">আজকের</div>
        </div>
    </div>

    <div class="overall-info">
        <h4>আজকের অগ্রগতি</h4>
        <p>
            @DateTime.Today.ToString("dddd, dd MMMM yyyy")
        </p>
        @if (!Model.IsAllDone)
        {
            <p style="margin-top:6px; font-size:12px; opacity:.75;">
                @(Model.IsMcqDone ? "✓ MCQ" : "◯ MCQ")
                &nbsp;&nbsp;
                @(Model.IsTopicDone ? "✓ Topic" : "◯ Topic")
                &nbsp;&nbsp;
                @(Model.IsNotesDone ? "✓ Notes" : "◯ Notes")
            </p>
        }
    </div>

    <div class="streak-badge">
        <div class="streak-num">@Model.CurrentStreak</div>
        <div class="streak-lbl">day streak 🔥</div>
    </div>
</div>

<!-- ══ 3 Goal rings ══ -->
<div class="row g-3 mb-4">

    <!-- MCQ -->
    <div class="col-12 col-md-4">
        <div class="goal-card @(Model.IsMcqDone ? "done" : "")">
            <span class="done-badge">✓ Done!</span>
            <div class="ring-container">
                <svg class="ring-svg" width="110" height="110"
                     viewBox="0 0 110 110">
                    <circle cx="55" cy="55" r="46" class="ring-bg" />
                    <circle cx="55" cy="55" r="46"
                            class="ring-fill"
                            stroke="#534AB7"
                            stroke-dasharray="289"
                            stroke-dashoffset="@(289 - 289 * Model.McqPercent / 100)"
                            id="mcq-ring" />
                </svg>
                <div class="ring-center">
                    <div class="ring-pct" style="color:#534AB7;">
                        @Model.McqPercent%
                    </div>
                    <div class="ring-sub">
                        @Model.TodayMcqDone/@Model.Goal.DailyMcqTarget
                    </div>
                </div>
            </div>
            <div class="goal-label">
                <i class="bi bi-question-circle me-1"></i>MCQ Practice
            </div>
            <div class="goal-count">
                আজকের লক্ষ্য: @Model.Goal.DailyMcqTarget টি প্রশ্ন
            </div>
            <div class="quick-btns">
                <button class="qbtn" onclick="quickLog('MCQ', 5)">+5</button>
                <button class="qbtn" onclick="quickLog('MCQ', 10)">+10</button>
                <button class="qbtn" onclick="quickLog('MCQ', 20)">+20</button>
            </div>
        </div>
    </div>

    <!-- Topic -->
    <div class="col-12 col-md-4">
        <div class="goal-card @(Model.IsTopicDone ? "done" : "")"
             id="topic-card">
            <span class="done-badge">✓ Done!</span>
            <div class="ring-container">
                <svg class="ring-svg" width="110" height="110"
                     viewBox="0 0 110 110">
                    <circle cx="55" cy="55" r="46" class="ring-bg" />
                    <circle cx="55" cy="55" r="46"
                            class="ring-fill"
                            stroke="#1D9E75"
                            stroke-dasharray="289"
                            stroke-dashoffset="@(289 - 289 * Model.TopicPercent / 100)"
                            id="topic-ring" />
                </svg>
                <div class="ring-center">
                    <div class="ring-pct" style="color:#1D9E75;">
                        @Model.TopicPercent%
                    </div>
                    <div class="ring-sub">
                        @Model.TodayTopicDone/@Model.Goal.DailyTopicTarget
                    </div>
                </div>
            </div>
            <div class="goal-label">
                <i class="bi bi-star me-1"></i>Topic Revision
            </div>
            <div class="goal-count">
                আজকের লক্ষ্য: @Model.Goal.DailyTopicTarget টি topic
            </div>
            <div class="quick-btns">
                <button class="qbtn"
                        style="color:#1D9E75;border-color:#5DCAA5;"
                        onclick="quickLog('Topic', 1)">
                    +1
                </button>
                <button class="qbtn"
                        style="color:#1D9E75;border-color:#5DCAA5;"
                        onclick="quickLog('Topic', 2)">
                    +2
                </button>
            </div>
        </div>
    </div>

    <!-- Notes -->
    <div class="col-12 col-md-4">
        <div class="goal-card @(Model.IsNotesDone ? "done" : "")"
             id="notes-card">
            <span class="done-badge">✓ Done!</span>
            <div class="ring-container">
                <svg class="ring-svg" width="110" height="110"
                     viewBox="0 0 110 110">
                    <circle cx="55" cy="55" r="46" class="ring-bg" />
                    <circle cx="55" cy="55" r="46"
                            class="ring-fill"
                            stroke="#BA7517"
                            stroke-dasharray="289"
                            stroke-dashoffset="@(289 - 289 * Model.NotesPercent / 100)"
                            id="notes-ring" />
                </svg>
                <div class="ring-center">
                    <div class="ring-pct" style="color:#BA7517;">
                        @Model.NotesPercent%
                    </div>
                    <div class="ring-sub">
                        @Model.TodayNotesDone/@Model.Goal.DailyNotesMinutes min
                    </div>
                </div>
            </div>
            <div class="goal-label">
                <i class="bi bi-journal-text me-1"></i>Notes Review
            </div>
            <div class="goal-count">
                আজকের লক্ষ্য: @Model.Goal.DailyNotesMinutes মিনিট
            </div>
            <div class="quick-btns">
                <button class="qbtn"
                        style="color:#BA7517;border-color:#EF9F27;"
                        onclick="quickLog('Notes', 15)">
                    +15 min
                </button>
                <button class="qbtn"
                        style="color:#BA7517;border-color:#EF9F27;"
                        onclick="quickLog('Notes', 30)">
                    +30 min
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">

    <!-- ══ Left — Week history + Manual log ══ -->
    <div class="col-12 col-lg-8">

        <!-- 7-day history -->
        <div class="panel mb-3">
            <div class="panel-header">
                <span>
                    <i class="bi bi-calendar3 me-1"
                       style="color:var(--primary);"></i>
                    গত ৭ দিনের অগ্রগতি
                </span>
                <span style="font-size:12px;color:#aaa;">
                    সবুজ = goal সম্পন্ন
                </span>
            </div>
            <div class="panel-body">
                <div class="week-row">
                    @foreach (var day in Model.WeekHistory)
                    {
                        bool isToday = day.Date == DateTime.Today;
                        string cls = isToday ? "today"
                        : day.GoalMet ? "goal-met"
                        : "";
                        <div class="day-cell @cls">
                            <div class="day-name">
                                @day.Date.ToString("ddd")
                            </div>
                            <div class="day-date">
                                @day.Date.Day
                            </div>
                            <div class="day-dot"></div>
                            @if (day.McqDone > 0 || day.TopicDone > 0)
                            {
                                <div style="font-size:10px;
                                            color:currentColor;
                                            margin-top:4px;
                                            opacity:.7;">
                                    @day.McqDone MCQ
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Manual activity log -->
        <div class="panel">
            <div class="panel-header">
                <span>
                    <i class="bi bi-plus-circle me-1"
                       style="color:var(--primary);"></i>
                    Activity Manual Log করো
                </span>
            </div>
            <div class="panel-body">
                <form asp-action="LogActivity"
                      asp-controller="StudyGoal"
                      method="post" class="manual-form">
                    @Html.AntiForgeryToken()

                    <select name="activityType" required
                            style="min-width:130px;">
                        <option value="">Type বেছে নাও</option>
                        <option value="MCQ">MCQ Practice</option>
                        <option value="Topic">Topic Revision</option>
                        <option value="Notes">Notes Review</option>
                    </select>

                    <input type="number" name="count"
                           min="1" max="999" required
                           placeholder="Count / Minutes"
                           style="width:140px;" />

                    <input type="text" name="description"
                           placeholder="Description (ঐচ্ছিক)"
                           style="flex:1; min-width:160px;" />

                    <button type="submit">
                        <i class="bi bi-plus me-1"></i>Log করো
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ══ Right — Settings + Today's log ══ -->
    <div class="col-12 col-lg-4">

        <!-- Goal settings -->
        <div class="panel mb-3">
            <div class="panel-header">
                <span>
                    <i class="bi bi-sliders me-1"
                       style="color:var(--primary);"></i>
                    Goal পরিবর্তন করো
                </span>
            </div>
            <div class="panel-body">
                <form asp-action="UpdateGoal"
                      asp-controller="StudyGoal"
                      method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label style="font-size:12px;font-weight:600;
                                       color:#555;margin-bottom:4px;display:block;">
                            <i class="bi bi-question-circle me-1"></i>
                            Daily MCQ Target
                        </label>
                        <input type="number" name="mcqTarget"
                               value="@Model.Goal.DailyMcqTarget"
                               min="1" max="200" required
                               class="form-control form-control-sm"
                               style="border-radius:8px;" />
                        <div style="font-size:11px;color:#aaa;margin-top:3px;">
                            প্রতিদিন কতটি MCQ practice করবো
                        </div>
                    </div>
                    <div class="mb-3">
                        <label style="font-size:12px;font-weight:600;
                                       color:#555;margin-bottom:4px;display:block;">
                            <i class="bi bi-star me-1"></i>
                            Daily Topic Target
                        </label>
                        <input type="number" name="topicTarget"
                               value="@Model.Goal.DailyTopicTarget"
                               min="1" max="20" required
                               class="form-control form-control-sm"
                               style="border-radius:8px;" />
                        <div style="font-size:11px;color:#aaa;margin-top:3px;">
                            প্রতিদিন কতটি topic revise করবো
                        </div>
                    </div>
                    <div class="mb-3">
                        <label style="font-size:12px;font-weight:600;
                                       color:#555;margin-bottom:4px;display:block;">
                            <i class="bi bi-journal-text me-1"></i>
                            Daily Notes (minutes)
                        </label>
                        <input type="number" name="notesMinutes"
                               value="@Model.Goal.DailyNotesMinutes"
                               min="5" max="300" required
                               class="form-control form-control-sm"
                               style="border-radius:8px;" />
                        <div style="font-size:11px;color:#aaa;margin-top:3px;">
                            প্রতিদিন কতক্ষণ notes পড়বো
                        </div>
                    </div>
                    <button type="submit"
                            style="width:100%;padding:9px;border-radius:8px;
                                   background:var(--primary);color:#fff;
                                   border:none;font-size:13px;
                                   font-weight:600;cursor:pointer;">
                        <i class="bi bi-check2 me-1"></i>Goal Save করো
                    </button>
                </form>
            </div>
        </div>

        <!-- Today's activity log -->
        <div class="panel">
            <div class="panel-header">
                <span>
                    <i class="bi bi-clock-history me-1"
                       style="color:var(--primary);"></i>
                    আজকের Activities
                </span>
                <span style="font-size:12px;background:#EEEDFE;
                             color:#534AB7;padding:2px 8px;
                             border-radius:10px;font-weight:600;">
                    @Model.TodayLogs.Count টি
                </span>
            </div>
            <div class="panel-body" style="max-height:300px;overflow-y:auto;">
                @if (!Model.TodayLogs.Any())
                {
                    <div style="text-align:center;padding:30px 0;color:#aaa;">
                        <i class="bi bi-hourglass"
                           style="font-size:28px;display:block;margin-bottom:8px;"></i>
                        <p style="font-size:13px;">
                            এখনো কোনো activity log হয়নি।<br />
                            শুরু করো! 💪
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var log in Model.TodayLogs)
                    {
                        var (iconClass, bgColor, textColor) =
                        log.ActivityType switch
                        {
                            "MCQ" => ("bi-question-circle",
                        "#EEEDFE", "#534AB7"),
                            "Topic" => ("bi-star",
                        "#E1F5EE", "#0F6E56"),
                            "Notes" => ("bi-journal-text",
                        "#FAEEDA", "#854F0B"),
                            _ => ("bi-activity",
                        "#f0f0ee", "#555")
                        };

                        var unitLabel = log.ActivityType == "Notes"
                        ? "min" : "টি";

                        <div class="log-item">
                            <div class="log-type-icon"
                                 style="background:@bgColor;color:@textColor;">
                                <i class="bi @iconClass"></i>
                            </div>
                            <div class="log-desc">
                                @if (!string.IsNullOrEmpty(log.Description))
                                {
                                    @log.Description
                                }
                                else
                                {
                                    @($"{log.ActivityType} activity")
                                }
                            </div>
                            <div class="log-count"
                                 style="color:@textColor;">
                                +@log.ActivityCount @unitLabel
                            </div>
                            <div class="log-time">
                                @log.CreatedAt.ToString("hh:mm tt")
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        setSidebarProgress(@Model.OverallTodayPercent);

        // Ring animate on load
        document.querySelectorAll('.ring-fill').forEach(ring => {
            const target = parseFloat(ring.getAttribute('stroke-dashoffset'));
            const total = parseFloat(ring.getAttribute('stroke-dasharray'));
            ring.style.strokeDashoffset = total;
            ring.style.transition = 'stroke-dashoffset 1s ease';
            setTimeout(() => { ring.style.strokeDashoffset = target; }, 100);
        });

        // Overall ring animate
        const oRing = document.getElementById('overall-ring');
        if (oRing) {
            const t = parseFloat(oRing.getAttribute('stroke-dashoffset'));
            oRing.style.strokeDashoffset = '226.2';
            oRing.style.transition = 'stroke-dashoffset 1s ease';
            setTimeout(() => { oRing.style.strokeDashoffset = t; }, 150);
        }

        // ── Quick Log (AJAX) ──
        function quickLog(type, count) {
            fetch('/StudyGoal/QuickLog', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken':
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: `activityType=${type}&count=${count}`
            })
                .then(r => r.json())
                .then(data => {
                    if (!data.success) return;

                    // Rings update করো
                    updateRing('mcq-ring', data.mcqPercent, 289);
                    updateRing('topic-ring', data.topicPercent, 289);
                    updateRing('notes-ring', data.notesPercent, 289);
                    updateRing('overall-ring', data.overallPct, 226.2);

                    // Percentage text update করো
                    document.querySelector('#mcq-ring').closest('svg')
                        .previousElementSibling?.querySelector('.ring-pct')
                        ?.setAttribute('data-pct', data.mcqPercent);

                    // Page reload করো যাতে log list ও count update হয়
                    setTimeout(() => location.reload(), 600);
                })
                .catch(() => location.reload());
        }

        function updateRing(id, pct, total) {
            const ring = document.getElementById(id);
            if (!ring) return;
            const offset = total - (total * pct / 100);
            ring.style.transition = 'stroke-dashoffset .6s ease';
            ring.style.strokeDashoffset = offset;
        }
    </script>
}