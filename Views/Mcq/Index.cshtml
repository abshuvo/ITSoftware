@model ITSoftware.Models.ViewModels.McqIndexViewModel
@{
    ViewData["Title"] = "Technical MCQ";
    ViewData["Subtitle"] = "MCQ practice এবং import";
}

@section Styles {
    <style>
        .tab-btn {
            padding: 7px 18px;
            border-radius: 8px;
            font-size: 13px;
            border: 1px solid #e8e7e2;
            background: #fff;
            color: #555;
            cursor: pointer;
            transition: all .15s;
        }

            .tab-btn.active, .tab-btn:hover {
                background: var(--primary-lt);
                color: var(--primary);
                border-color: var(--primary-md);
                font-weight: 600;
            }

        .tab-content {
            display: none;
        }

            .tab-content.active {
                display: block;
            }

        .mcq-card {
            background: #fff;
            border: 1px solid #e8e7e2;
            border-radius: 10px;
            padding: 14px 16px;
            transition: box-shadow .15s;
        }

            .mcq-card:hover {
                box-shadow: 0 3px 10px rgba(0,0,0,.06);
            }

        .mcq-question {
            font-size: 13px;
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: 8px;
        }

        .mcq-options {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 8px;
        }

        .mcq-opt-pill {
            font-size: 12px;
            padding: 3px 10px;
            border-radius: 6px;
            background: #f5f5f3;
            border: 1px solid #e8e7e2;
            color: #555;
        }

            .mcq-opt-pill.correct {
                background: var(--teal-lt);
                border-color: #5DCAA5;
                color: #085041;
                font-weight: 600;
            }

        .cat-chip {
            display: inline-block;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 20px;
            background: var(--primary-lt);
            color: var(--primary);
            border: 1px solid var(--primary-md);
            cursor: pointer;
            transition: all .15s;
            text-decoration: none;
        }

            .cat-chip:hover, .cat-chip.active {
                background: var(--primary);
                color: #fff;
            }

        .quiz-start-card {
            background: linear-gradient(135deg, #534AB7 0%, #7F77DD 100%);
            border-radius: 14px;
            padding: 28px 24px;
            color: #fff;
            text-align: center;
        }

            .quiz-start-card h5 {
                font-size: 18px;
                font-weight: 700;
                margin-bottom: 6px;
            }

            .quiz-start-card p {
                font-size: 13px;
                opacity: .85;
                margin-bottom: 20px;
            }

        .btn-quiz-start {
            display: inline-block;
            padding: 10px 28px;
            background: #fff;
            color: var(--primary);
            border-radius: 8px;
            font-weight: 700;
            font-size: 14px;
            text-decoration: none;
            transition: opacity .15s;
        }

            .btn-quiz-start:hover {
                opacity: .9;
                color: var(--primary);
            }

        .csv-format-box {
            background: #1a1a2e;
            color: #a8f0a8;
            border-radius: 8px;
            padding: 14px 16px;
            font-size: 12px;
            font-family: 'Courier New', monospace;
            overflow-x: auto;
            margin-top: 10px;
        }
    </style>
}

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert mb-3"
         style="background:#E1F5EE;border:1px solid #5DCAA5;
                    border-radius:10px;color:#085041;font-size:13px;">
        <i class="bi bi-check-circle-fill me-1"></i>@TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert mb-3"
         style="background:#FAECE7;border:1px solid #F0997B;
                    border-radius:10px;color:#712B13;font-size:13px;">
        <i class="bi bi-exclamation-circle-fill me-1"></i>@TempData["Error"]
    </div>
}

<div class="row g-4">

    <!-- ══ Left column ══ -->
    <div class="col-12 col-lg-4">

        <!-- Quiz start card -->
        <div class="quiz-start-card mb-3">
            <h5><i class="bi bi-play-circle me-1"></i>Quiz Mode</h5>
            <p>সব MCQ shuffle করে quiz শুরু করো</p>
            <a asp-action="StartQuiz" asp-controller="Mcq"
               class="btn-quiz-start">
                <i class="bi bi-play-fill me-1"></i>Quiz শুরু করো
            </a>
            @if (Model.Categories.Any())
            {
                <div style="margin-top:12px; font-size:12px; opacity:.8;">
                    অথবা category অনুযায়ী:
                </div>
                <div style="margin-top:6px; display:flex; flex-wrap:wrap;
                                gap:6px; justify-content:center;">
                    @foreach (var cat in Model.Categories)
                    {
                        <a asp-action="StartQuiz" asp-controller="Mcq"
                           asp-route-category="@cat"
                           style="font-size:11px; padding:4px 10px; border-radius:6px;
                                          background:rgba(255,255,255,.2); color:#fff;
                                          text-decoration:none; border:1px solid rgba(255,255,255,.3);">
                            @cat
                        </a>
                    }
                </div>
            }
        </div>

        <!-- Tabs: Import / Add manually -->
        <div style="background:#fff;border:1px solid #e8e7e2;border-radius:12px;overflow:hidden;">
            <div style="padding:14px 16px;border-bottom:1px solid #f0f0ee;">
                <div class="d-flex gap-2">
                    <button class="tab-btn active" onclick="switchTab('import', this)">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i>CSV Import
                    </button>
                    <button class="tab-btn" onclick="switchTab('manual', this)">
                        <i class="bi bi-plus-circle me-1"></i>Manual Add
                    </button>
                </div>
            </div>
            <div style="padding:16px;">

                <!-- Tab 1: CSV Import -->
                <div class="tab-content active" id="tab-import">
                    <form asp-action="Import" asp-controller="Mcq"
                          method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label style="font-size:12px;font-weight:600;
                                          color:#555;margin-bottom:4px;display:block;">
                                CSV File Select করো
                            </label>
                            <input type="file" name="file" accept=".csv"
                                   class="form-control form-control-sm"
                                   style="border-radius:8px;font-size:12px;" />
                        </div>
                        <button type="submit"
                                style="width:100%;padding:9px;border-radius:8px;
                                       background:var(--primary);color:#fff;border:none;
                                       font-size:13px;font-weight:600;cursor:pointer;">
                            <i class="bi bi-upload me-1"></i>Import করো
                        </button>
                    </form>

                    <!-- CSV format guide -->
                    <div style="margin-top:14px;">
                        <div style="font-size:12px;font-weight:600;color:#555;">
                            CSV Format:
                        </div>
                        <div class="csv-format-box">
                            Question,OptionA,OptionB,OptionC,OptionD,Answer,Explanation,Category<br />
                            "Stack uses LIFO?","True","False","Maybe","None","A","LIFO = Last In First Out","DSA"
                        </div>
                        <a href="#" onclick="downloadSample()"
                           style="font-size:11px;color:var(--primary);
                                  text-decoration:none;display:block;margin-top:6px;">
                            <i class="bi bi-download me-1"></i>Sample CSV download করো
                        </a>
                    </div>
                </div>

                <!-- Tab 2: Manual Add -->
                <div class="tab-content" id="tab-manual">
                    <form asp-action="Add" asp-controller="Mcq" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label style="font-size:12px;font-weight:600;
                                          color:#555;margin-bottom:3px;display:block;">
                                Question <span style="color:red;">*</span>
                            </label>
                            <textarea name="QuestionText" rows="2" required
                                      class="form-control form-control-sm"
                                      placeholder="প্রশ্নটি লিখো..."
                                      style="border-radius:8px;font-size:13px;resize:none;">
                            </textarea>
                        </div>
                        @foreach (var opt in new[] { "A", "B", "C", "D" })
                        {
                            <div class="mb-2">
                                <input type="text" name="Option@opt"
                                       placeholder="Option @opt"
                                       required
                                       class="form-control form-control-sm"
                                       style="border-radius:8px;font-size:12px;" />
                            </div>
                        }
                        <div class="mb-2">
                            <select name="CorrectAnswer" required
                                    class="form-select form-select-sm"
                                    style="border-radius:8px;font-size:12px;">
                                <option value="">সঠিক উত্তর বেছে নাও</option>
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <input type="text" name="Category"
                                   placeholder="Category (যেমন: DSA, Network)"
                                   class="form-control form-control-sm"
                                   style="border-radius:8px;font-size:12px;" />
                        </div>
                        <div class="mb-3">
                            <textarea name="Explanation" rows="2"
                                      class="form-control form-control-sm"
                                      placeholder="Explanation (ঐচ্ছিক)..."
                                      style="border-radius:8px;font-size:12px;resize:none;">
                            </textarea>
                        </div>
                        <button type="submit"
                                style="width:100%;padding:9px;border-radius:8px;
                                       background:var(--teal);color:#fff;border:none;
                                       font-size:13px;font-weight:600;cursor:pointer;">
                            <i class="bi bi-plus-circle me-1"></i>MCQ যোগ করো
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Right column — MCQ list ══ -->
    <div class="col-12 col-lg-8">
        <div style="background:#fff;border:1px solid #e8e7e2;
                    border-radius:12px;overflow:hidden;">
            <div style="padding:14px 18px;border-bottom:1px solid #f0f0ee;">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span style="font-size:13px;font-weight:600;">
                        <i class="bi bi-list-ul me-1" style="color:var(--primary);"></i>
                        সব MCQ
                        <span style="font-size:12px;background:#EEEDFE;color:#534AB7;
                                     padding:2px 8px;border-radius:20px;
                                     margin-left:4px;font-weight:600;">
                            @Model.TotalCount টি
                        </span>
                    </span>
                    <!-- Category filter -->
                    <div class="d-flex flex-wrap gap-1">
                        <a asp-action="Index" class="cat-chip @(Model.FilterCategory == null ? "active" : "")">
                            সব
                        </a>
                        @foreach (var cat in Model.Categories)
                        {
                            <a asp-action="Index" asp-route-category="@cat"
                               class="cat-chip @(Model.FilterCategory == cat ? "active" : "")">
                                @cat
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div style="padding:16px;">
                @if (!Model.Questions.Any())
                {
                    <div style="text-align:center;padding:50px 20px;color:#aaa;">
                        <i class="bi bi-question-circle"
                           style="font-size:40px;display:block;margin-bottom:10px;"></i>
                        <p style="font-size:13px;">
                            এখনো কোনো MCQ নেই।<br />CSV import অথবা manually যোগ করো।
                        </p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var q in Model.Questions)
                        {
                            <div class="mcq-card">
                                <div class="mcq-question">@q.QuestionText</div>
                                <div class="mcq-options">
                                    @foreach (var (opt, label) in new[]
                                                                {
                                                        (q.OptionA,"A"),(q.OptionB,"B"),
                                                        (q.OptionC,"C"),(q.OptionD,"D")
                                                        })
                                    {
                                        <span class="mcq-opt-pill @(label == q.CorrectAnswer ? "correct" : "")">
                                            @label. @opt
                                            @if (label == q.CorrectAnswer)
                                            {
                                                <i class="bi bi-check2 ms-1"></i>
                                            }
                                        </span>
                                    }
                                </div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        @if (!string.IsNullOrEmpty(q.Category))
                                        {
                                            <span style="font-size:11px;background:var(--primary-lt);
                                                                     color:var(--primary);padding:2px 8px;
                                                                     border-radius:10px;">
                                                @q.Category
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(q.Explanation))
                                        {
                                            <span style="font-size:11px;color:#888;margin-left:6px;">
                                                <i class="bi bi-info-circle me-1"></i>@q.Explanation
                                            </span>
                                        }
                                    </div>
                                    <form asp-action="Delete" asp-controller="Mcq"
                                          method="post"
                                          onsubmit="return confirm('Delete করবে?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@q.Id" />
                                        <button type="submit"
                                                style="font-size:11px;padding:4px 10px;
                                                               border-radius:6px;background:#FAECE7;
                                                               color:#993C1D;border:1px solid #F0997B;
                                                               cursor:pointer;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
            setSidebarProgress(0);

            function switchTab(name, btn) {
                document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.getElementById('tab-' + name).classList.add('active');
                btn.classList.add('active');
            }

            function downloadSample() {
                const csv = `Question,OptionA,OptionB,OptionC,OptionD,CorrectAnswer,Explanation,Category
        "Which data structure uses LIFO?","Stack","Queue","Array","Tree","A","Last In First Out","DSA"
        "SQL SELECT statement does what?","Insert data","Delete data","Retrieve data","Update data","C","Basic SQL","Database"
        "What does HTTP stand for?","HyperText Transfer Protocol","High Transfer Protocol","HyperText Transport Process","None","A","Web basics","Network"`;

                const blob = new Blob([csv], { type: 'text/csv' });
                const a    = document.createElement('a');
                a.href     = URL.createObjectURL(blob);
                a.download = 'mcq_sample.csv';
                a.click();
            }
    </script>
}